#!/usr/bin/env bash
# One-shot helper for the interactive Spotify OAuth logins spotify-player
# needs once. Runs `spotify_player authenticate`, watches its output for each
# "Browse to: <url>" prompt, and opens each one in the default browser.
#
# Why this is more than a convenience: with streaming enabled (the default,
# and the whole point on aarch64) spotify-player runs *two* independent OAuth
# flows back to back, under two different client IDs --
#
#   1. the Web API token   (ncspot's client ID; cached as <client_id>_token.json)
#   2. the librespot session (Spotify's official client ID; cached as credentials.json)
#
# -- so Spotify demands two separate approvals, and the second URL only
# appears after the first is done. A person watching the terminal will often
# approve the first, see the app sit there, and assume it hung. This loops
# until the process exits, opening each URL as it shows up.
#
# Unlike the ncspot equivalent, no tmux/capture-pane scraping is needed:
# spotify_player prints each URL as a single line on stdout, so it can just
# be piped. The ncspot helper has to stitch a visually wrapped URL back
# together out of a tmux pane because ncspot prints it into its own TUI.
set -euo pipefail

session="spotify-player"

if ! command -v spotify_player >/dev/null 2>&1; then
  echo "spotify_player is not installed -- run ./install.sh --player spotify-player first." >&2
  exit 1
fi

log="$(mktemp -t spotify-player-login.XXXXXX)"
# Set while the placeholder session below is holding the session name. On any
# exit path -- success, authentication failure, Ctrl-C -- the placeholder has
# to go, or the keepalive service sees an occupied name and never respawns the
# real player.
parked=""
cleanup() {
  rm -f "$log"
  [[ -n "$parked" ]] && tmux kill-session -t "=$parked" 2>/dev/null
  return 0
}
trap cleanup EXIT

open_url() {
  local url="$1"
  echo "==> Opening Spotify login in your browser:"
  echo "    $url"
  if command -v uwsm-app >/dev/null 2>&1; then
    setsid uwsm-app -- xdg-open "$url" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    setsid xdg-open "$url" >/dev/null 2>&1 &
  else
    echo "    (no xdg-open found -- open that URL yourself)" >&2
  fi
}

# The tmux keepalive session holds the librespot device open, and a second
# copy of spotify-player would fight it for the OAuth callback port (8989)
# and register a duplicate Spotify Connect device. Stop it for the duration.
# "=" is tmux's exact-match target prefix, and it matters most here: without it
# a target also matches as a prefix, and these are kills. It works on
# has-session, kill-session and attach-session; set-option rejects it outright
# ("no such session: =x" on tmux 3.7), which is why the set-options below stay
# bare.
if tmux has-session -t "=$session" 2>/dev/null; then
  echo "==> Stopping the keepalive session while authenticating"
  tmux kill-session -t "=$session"
fi

# Killing it isn't enough on its own: Service.qml re-checks every 15s and only
# looks at whether a session of this name exists, so it would respawn
# spotify_player in the middle of the login and reintroduce exactly the
# contention the kill above was for. Park a do-nothing session under the name
# for the duration. If this script dies without cleaning up, the `sleep`
# eventually ends, the session goes with it, and the keepalive respawns the
# real player on its next tick.
tmux new-session -d -s "$session" 'sleep 900'
parked="$session"

echo "==> Authenticating (expect TWO browser approvals: Web API, then librespot)"
spotify_player authenticate >"$log" 2>&1 &
auth_pid=$!

seen=""
while kill -0 "$auth_pid" 2>/dev/null; do
  # grep -o keeps this robust against the surrounding "Browse to: " prose and
  # against the two URLs differing in query-parameter order, which they do.
  # The character class is a positive list of what these URLs are made of,
  # rather than "anything that isn't a space": the negated version also captured
  # a trailing carriage return, or a comma if the prose ever put one after the
  # URL, and handed that to the browser as part of the address.
  while read -r url; do
    case " $seen " in *" $url "*) continue ;; esac
    seen="$seen $url"
    open_url "$url"
  done < <(grep -oE 'https://accounts\.spotify\.com/authorize[A-Za-z0-9._~:/?&=%+-]*' "$log" 2>/dev/null || true)
  sleep 0.5
done

wait "$auth_pid" && rc=0 || rc=$?
cat "$log"
if [[ $rc -ne 0 ]]; then
  echo "==> Authentication failed (exit $rc)." >&2
  exit "$rc"
fi

cache="${XDG_CACHE_HOME:-$HOME/.cache}/spotify-player"
echo "==> Cached credentials in $cache:"
# `ls | sed` under `set -o pipefail` fails the whole pipeline when the cache
# directory is missing, and `set -e` would then abort the script one line
# before it restarts the keepalive session -- i.e. a cosmetic listing would
# leave the player down. Guard it.
if [[ -d "$cache" ]]; then
  ls -1 "$cache" | sed 's/^/    /'
else
  echo "    (nothing there -- authentication wrote no cache)"
fi

echo "==> Starting the keepalive session"
tmux kill-session -t "=$session" 2>/dev/null || true
parked=""
tmux new-session -d -s "$session" spotify_player
# Created detached, so the graphics-protocol probe had nobody to answer it:
# tag it the same way Service.qml tags the sessions it creates blind, so the
# bar-widget button knows to recreate it with a client attached and get real
# Sixel album art instead of half-blocks. Without this tag the flag is absent,
# the button never recreates, and the art stays blocky for the session's whole
# life -- see the README's "headless caveat".
tmux set-option -t "$session" @headless 1
# Cosmetic, and identical to the ncspot path so the two backends read the same
# in the window's top-left. tmux chrome only; the session name is unchanged.
tmux set-option -t "$session" status-left-length 20
tmux set-option -t "$session" status-left "#[fg=#000000,bg=#c0c0c0,bold] Media Player #[default] "
echo "==> Done. Click the music-note bar widget to open the TUI."
